# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/interview_ai

# JWT Authentication Secret
JWT_SECRET=supersecret_interviewai_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# OpenAI API Key (Optional - application runs offline dynamic simulation when omitted)
OPENAI_API_KEY=

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
